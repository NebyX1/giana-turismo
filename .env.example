# Use the signed-in Ollama app; DeepSeek executes in Ollama Cloud.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# For direct https://ollama.com access, set an API key instead.
OLLAMA_API_KEY=

# Fixed retrieval pair; other IDs are rejected at startup.
EMBEDDING_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
QDRANT_COLLECTION=giana_granite_cpu_v1
# Embedded Qdrant persists in storage/qdrant.
CPU_THREADS=4
MODEL_BATCH_SIZE=8
MODEL_MAX_TOKENS=512
PORT=5000
WEB_CONSENT_TTL_SECONDS=120
GIANA_DIAGNOSTICS=false
