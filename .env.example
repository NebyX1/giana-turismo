# Required for LLM and web search
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
# The effective router/answer/fallback models are in
# backend/app/runtime_config.json. OLLAMA_MODEL and OLLAMA_FALLBACK_MODEL are
# legacy variables and are not read by the current backend.

# Local retrieval
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=giana_granite_v2
EMBEDDING_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Local services
BACKEND_URL=http://127.0.0.1:5000
PIPER_URL=http://127.0.0.1:5001/synthesize
PIPER_VOICE=es_AR-daniela-high
TTS_PROVIDER=piper
PORT=5000
WEB_CONSENT_TTL_SECONDS=120

# STT: large-v3-turbo CT2 local, CUDA explícito. Rollback: STT_PROVIDER=moonshine
STT_PROVIDER=whisper_turbo
STT_MODEL=large-v3-turbo
STT_MODEL_PATH=models/whisper-large-v3-turbo
STT_DEVICE=cuda
STT_DEVICE_INDEX=0
STT_LANGUAGE=es
STT_TASK=transcribe
STT_COMPUTE_TYPE=int8_float16
STT_BEAM_SIZE=1
STT_NUM_WORKERS=1
STT_HOTWORDS=Lavalleja Minas Cerro Arequita Villa Serrana Salto del Penitente Solís de Mataojo José Pedro Varela Mariscala Zapicán Pirarajá Parque Salus Giana Gianna

# Voice input / anti-noise. Browser VITE_* values belong in frontend/.env.local
# (or the environment used to launch Vite); they are not read from this root .env.
AUDIO_DENOISE_ENABLED=true
# Calibrated with short Spanish synthetic speech; stronger values lost "Sí/No".
VAD_CONFIDENCE=0.60
VAD_START_SECS=0.064
VAD_STOP_SECS=0.60
VAD_MIN_VOLUME=0.10
STT_VAD_FILTER=true
STT_VAD_THRESHOLD=0.50
STT_QUALITY_GATE_ENABLED=true
STT_MAX_NO_SPEECH_PROB=0.40
STT_MIN_AVG_LOGPROB=-1.0

# Optional diagnostics and LiveKit
GIANA_DIAGNOSTICS=false
GIANA_TRACE_SOURCE=human
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
